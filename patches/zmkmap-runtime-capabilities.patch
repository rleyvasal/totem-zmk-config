 if (unzigzag32(fieldU32(sf, 1)) !== 7) throw new Error("sint field");
 
+const runtimeCapabilities = concatBytes([
+  encodeUint32(1, 1),
+  encodeUint32(2, 1),
+  encodeUint32(2, 3),
+  encodeUint32(3, 5),
