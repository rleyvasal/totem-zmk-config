   el.className = `studio-state ${kind}`.trim();
 }
 
+function studioRuntimeHint(client) {
+  const caps = client?.runtimeCapabilities;
+  if (!caps) {
+    return "Live Apply works for existing bindings only. New macros, combos, layers, and behaviors require Download → flash.";
+  }
+  if (!caps.features?.length) {
+    return `Runtime keymap extension protocol v${caps.protocolVersion} detected. Dynamic definitions are not enabled in this firmware build yet.`;
+  }
+  return `Runtime keymap extension v${caps.protocolVersion} is available. The editor will enable each live feature supported by this firmware.`;
+}
+
 function updateStudioButtons() {
