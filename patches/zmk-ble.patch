+void zmk_ble_totem_kick_open_adv(void) {
+    if (adv_throttled) {
+        return;
+    }
+    if (zmk_ble_active_profile_is_connected()) {
+        return;
+    }
+    if (advertising_status != ZMK_ADV_CONN && advertising_status != ZMK_ADV_DIR) {
+        update_advertising();
+    } else {
+        open_adv_retry_arm();
+    }
+}
