+        LOG_INF("Advertising idle timeout; pausing advertising until a key is pressed");
+        int err = bt_le_adv_stop();
+        if (err) {
+            LOG_ERR("Failed to pause advertising (err %d)", err);
+            return;
+        }
+        advertising_status = ZMK_ADV_NONE;
+        adv_throttled = true;
+    }
+}
