+        k_work_schedule(&open_adv_retry_work, K_MSEC(OPEN_ADV_RETRY_MS));
+    } else if (advertising_status == ZMK_ADV_CONN) {
+        open_adv_retry_count = 0;
+    } else if (!zmk_ble_active_profile_is_connected()) {
+        k_work_schedule(&open_adv_retry_work, K_MSEC(OPEN_ADV_RETRY_MS));
+    }
