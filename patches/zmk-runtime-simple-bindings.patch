+#define ZMK_RUNTIME_KEYMAP_BUNDLE_MAGIC 0x524B4231U /* RKB1 */
+#define ZMK_RUNTIME_KEYMAP_BUNDLE_VERSION 1U
+
+/*
+ * Bundle v1 is intentionally small: one complete keyboard layer of encoded
+ * ZMK key usages. The upper byte of encoded_keycode contains the normal ZMK
+ * modifier flags, so one record can express a direct shortcut such as
+ * Cmd+Ctrl+Q without defining a new behavior in firmware.
+ */
+struct zmk_runtime_keymap_bundle_header {
+    uint32_t magic;
+    uint16_t version;
+    uint16_t header_size;
+    uint16_t layer_count;
+    uint16_t key_count;
+    uint16_t binding_size;
+    uint16_t reserved;
+} __packed;
+
+struct zmk_runtime_keymap_binding_v1 {
+    uint32_t encoded_keycode;
+} __packed;
+
