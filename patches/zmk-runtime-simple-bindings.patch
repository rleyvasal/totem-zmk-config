diff --git a/Users/admin/zmk/app/src/runtime_keymap_bindings.c b/app/src/runtime_keymap_bindings.c
new file mode 100644
index 0000000..42d9f38
--- /dev/null
+++ b/app/src/runtime_keymap_bindings.c
@@ -0,0 +1,152 @@
+/*
+ * Copyright (c) 2026
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <errno.h>
+#include <string.h>
+
+#include <zephyr/kernel.h>
+#include <zephyr/sys/util.h>
+
+#include <dt-bindings/zmk/hid_usage_pages.h>
+#include <zmk/events/keycode_state_changed.h>
+#include <zmk/hid.h>
+#include <zmk/keymap.h>
+#include <zmk/keys.h>
+#include <zmk/matrix.h>
+#include <zmk/runtime_keymap.h>
+
+static const uint8_t *active_bundle;
+static bool runtime_bindings_active;
+static bool captured_positions[ZMK_KEYMAP_LEN];
+static uint32_t pressed_keycodes[ZMK_KEYMAP_LEN];
+
+static bool encoded_keycode_is_valid(uint32_t encoded_keycode) {
+    if (encoded_keycode == 0) {
+        return true;
+    }
+
+    uint16_t usage_page = ZMK_HID_USAGE_PAGE(encoded_keycode);
+    const uint16_t keycode = ZMK_HID_USAGE_ID(encoded_keycode);
+    if (usage_page == 0) {
+        usage_page = HID_USAGE_KEY;
+    }
+
+    if (usage_page != HID_USAGE_KEY || keycode == 0 ||
+        keycode > ZMK_HID_KEYBOARD_NKRO_MAX_USAGE) {
+        return false;
+    }
+
+    // A modifier key uses ZMK's explicit-modifier path and therefore cannot
+    // also carry implicit modifiers of its own.
+    return !is_mod(usage_page, keycode) || SELECT_MODS(encoded_keycode) == 0;
+}
+
+static int read_bundle_header(const uint8_t *data, size_t size,
+                              struct zmk_runtime_keymap_bundle_header *header) {
+    if (!data || size < sizeof(*header)) {
+        return -EINVAL;
+    }
+
+    memcpy(header, data, sizeof(*header));
+    if (header->magic != ZMK_RUNTIME_KEYMAP_BUNDLE_MAGIC ||
+        header->version != ZMK_RUNTIME_KEYMAP_BUNDLE_VERSION ||
+        header->header_size != sizeof(*header) || header->layer_count != 1 ||
+        header->key_count != ZMK_KEYMAP_LEN ||
+        header->binding_size != sizeof(struct zmk_runtime_keymap_binding_v1) ||
+        header->reserved != 0) {
+        return -EINVAL;
+    }
+
+    const size_t expected_size =
+        header->header_size + ((size_t)header->layer_count * header->key_count * header->binding_size);
+    return size == expected_size ? 0 : -EMSGSIZE;
+}
+
+static uint32_t bundle_keycode_at(const uint8_t *bundle, uint32_t position) {
+    struct zmk_runtime_keymap_binding_v1 binding;
+    const size_t offset = sizeof(struct zmk_runtime_keymap_bundle_header) +
+                          ((size_t)position * sizeof(binding));
+    memcpy(&binding, &bundle[offset], sizeof(binding));
+    return binding.encoded_keycode;
+}
+
+int zmk_runtime_keymap_bundle_validate(const uint8_t *data, size_t size) {
+    struct zmk_runtime_keymap_bundle_header header;
+    int err = read_bundle_header(data, size, &header);
+    if (err < 0) {
+        return err;
+    }
+
+    for (uint32_t position = 0; position < header.key_count; position++) {
+        if (!encoded_keycode_is_valid(bundle_keycode_at(data, position))) {
+            return -EINVAL;
+        }
+    }
+
+    return 0;
+}
+
+static void release_runtime_keycodes(void) {
+    const int64_t timestamp = k_uptime_get();
+    for (uint32_t position = 0; position < ZMK_KEYMAP_LEN; position++) {
+        const uint32_t encoded_keycode = pressed_keycodes[position];
+        if (encoded_keycode != 0) {
+            (void)raise_zmk_keycode_state_changed_from_encoded(encoded_keycode, false, timestamp);
+            pressed_keycodes[position] = 0;
+        }
+    }
+}
+
+int zmk_runtime_keymap_bundle_activate(const uint8_t *data, size_t size) {
+    int err = zmk_runtime_keymap_bundle_validate(data, size);
+    if (err < 0) {
+        return err;
+    }
+
+    // Releasing currently-held runtime keys before the pointer swap prevents a
+    // live update from leaving a key or modifier held under the old mapping.
+    release_runtime_keycodes();
+    active_bundle = data;
+    runtime_bindings_active = true;
+    return 0;
+}
+
+void zmk_runtime_keymap_bundle_deactivate(void) {
+    release_runtime_keycodes();
+    active_bundle = NULL;
+    runtime_bindings_active = false;
+}
+
+bool zmk_runtime_keymap_bundle_is_active(void) { return runtime_bindings_active; }
+
+int zmk_runtime_keymap_position_state_changed(uint32_t position, bool pressed, int64_t timestamp) {
+    if (position >= ZMK_KEYMAP_LEN) {
+        return runtime_bindings_active ? -EINVAL : -ENOTSUP;
+    }
+
+    if (pressed) {
+        if (!runtime_bindings_active) {
+            return -ENOTSUP;
+        }
+
+        const uint32_t encoded_keycode = bundle_keycode_at(active_bundle, position);
+        captured_positions[position] = true;
+        pressed_keycodes[position] = encoded_keycode;
+        return encoded_keycode == 0
+                   ? 0
+                   : raise_zmk_keycode_state_changed_from_encoded(encoded_keycode, true, timestamp);
+    }
+
+    if (!runtime_bindings_active && !captured_positions[position]) {
+        return -ENOTSUP;
+    }
+
+    const uint32_t encoded_keycode = pressed_keycodes[position];
+    pressed_keycodes[position] = 0;
+    captured_positions[position] = false;
+    return encoded_keycode == 0
+               ? 0
+               : raise_zmk_keycode_state_changed_from_encoded(encoded_keycode, false, timestamp);
+}
