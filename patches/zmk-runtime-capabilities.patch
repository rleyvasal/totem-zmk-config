index 1d51975c..26884f2e 100644
--- a/app/src/studio/keymap_subsystem.c
+++ b/app/src/studio/keymap_subsystem.c
@@ -112,6 +112,16 @@ static void populate_keymap_extra_props(zmk_keymap_Keymap *keymap) {
     }
 }
 
+/*
+ * This is deliberately a capability advertisement only. Subsequent runtime
+ * keymap patches add feature bits and pool limits once their corresponding
+ * engines, validation, and settings persistence exist.
+ */
+static void populate_runtime_capabilities(zmk_keymap_Keymap *keymap) {
+    keymap->has_runtime_capabilities = true;
+    keymap->runtime_capabilities.protocol_version = 1;
+}
+
 zmk_studio_Response get_keymap(const zmk_studio_Request *req) {
     LOG_DBG("");
     zmk_keymap_Keymap resp = zmk_keymap_Keymap_init_zero;
@@ -119,6 +129,7 @@ zmk_studio_Response get_keymap(const zmk_studio_Request *req) {
     resp.layers.funcs.encode = encode_keymap_layers;
 
     populate_keymap_extra_props(&resp);
+    populate_runtime_capabilities(&resp);
 
     return KEYMAP_RESPONSE(get_keymap, resp);
 }
