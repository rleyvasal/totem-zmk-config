diff --git a/app/src/ble.c b/app/src/ble.c
index 51b172b..98303c4 100644
--- a/app/src/ble.c
+++ b/app/src/ble.c
@@ -37,6 +37,10 @@ LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
 #include <zmk/event_manager.h>
 #include <zmk/events/ble_active_profile_changed.h>
 
+#if IS_ENABLED(CONFIG_TOTEM_ADV_THROTTLE) && IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+#include <zmk/events/position_state_changed.h>
+#endif
+
 #if IS_ENABLED(CONFIG_ZMK_BLE_PASSKEY_ENTRY)
 #include <zmk/events/keycode_state_changed.h>
 
@@ -59,6 +63,15 @@ enum advertising_type {
     BT_LE_ADV_PARAM(BT_LE_ADV_OPT_CONN | BT_LE_ADV_OPT_USE_NAME | BT_LE_ADV_OPT_FORCE_NAME_IN_AD,  \
                     BT_GAP_ADV_FAST_INT_MIN_2, BT_GAP_ADV_FAST_INT_MAX_2, NULL)
 
+#if IS_ENABLED(CONFIG_TOTEM_ACTIVE_PROFILE_ONLY) && IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+/* Same as ZMK_ADV_CONN_NAME but only accepts connection requests from the accept
+ * list (the active profile's bonded peer), so other paired devices are ignored. */
+#define ZMK_ADV_CONN_NAME_FILTERED                                                                 \
+    BT_LE_ADV_PARAM(BT_LE_ADV_OPT_CONN | BT_LE_ADV_OPT_USE_NAME | BT_LE_ADV_OPT_FORCE_NAME_IN_AD | \
+                        BT_LE_ADV_OPT_FILTER_CONN,                                                 \
+                    BT_GAP_ADV_FAST_INT_MIN_2, BT_GAP_ADV_FAST_INT_MAX_2, NULL)
+#endif
+
 static struct zmk_ble_profile profiles[ZMK_BLE_PROFILE_COUNT];
 static uint8_t active_profile;
 
@@ -166,14 +179,58 @@ bool zmk_ble_profile_is_connected(uint8_t index) {
     }                                                                                              \
     advertising_status = ZMK_ADV_DIR;
 
+#if IS_ENABLED(CONFIG_TOTEM_ACTIVE_PROFILE_ONLY) && IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+/* Bonded profile -> advertise filtered by accept list so only that device can
+ * connect; open profile (pairing) -> advertise normally so new devices can pair. */
+static int zmk_open_adv_start(void) {
+    if (!zmk_ble_active_profile_is_open()) {
+        bt_le_filter_accept_list_clear();
+        int aerr = bt_le_filter_accept_list_add(zmk_ble_active_profile_addr());
+        if (aerr) {
+            /* Fail open: don't lock everyone out if the accept list can't be
+             * built -- advertise normally so at least the active host connects. */
+            LOG_WRN("Accept list add failed (%d); advertising unfiltered", aerr);
+            return bt_le_adv_start(ZMK_ADV_CONN_NAME, zmk_ble_ad, ARRAY_SIZE(zmk_ble_ad), NULL, 0);
+        }
+        return bt_le_adv_start(ZMK_ADV_CONN_NAME_FILTERED, zmk_ble_ad, ARRAY_SIZE(zmk_ble_ad), NULL,
+                               0);
+    }
+    return bt_le_adv_start(ZMK_ADV_CONN_NAME, zmk_ble_ad, ARRAY_SIZE(zmk_ble_ad), NULL, 0);
+}
+#else
+static inline int zmk_open_adv_start(void) {
+    return bt_le_adv_start(ZMK_ADV_CONN_NAME, zmk_ble_ad, ARRAY_SIZE(zmk_ble_ad), NULL, 0);
+}
+#endif
+
 #define CHECKED_OPEN_ADV()                                                                         \
-    err = bt_le_adv_start(ZMK_ADV_CONN_NAME, zmk_ble_ad, ARRAY_SIZE(zmk_ble_ad), NULL, 0);         \
+    err = zmk_open_adv_start();                                                                     \
     if (err) {                                                                                     \
         LOG_ERR("Advertising failed to start (err %d)", err);                                      \
         return err;                                                                                \
     }                                                                                              \
     advertising_status = ZMK_ADV_CONN;
 
+#if IS_ENABLED(CONFIG_TOTEM_ADV_THROTTLE) && IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+static bool adv_throttled = false;
+static struct k_work_delayable adv_throttle_work;
+
+/* Fires once the host has been gone for the timeout: stop advertising to save
+ * power. A key press resumes it (see the listener below). */
+static void adv_throttle_work_handler(struct k_work *work) {
+    if (advertising_status == ZMK_ADV_CONN && !zmk_ble_active_profile_is_connected()) {
+        LOG_INF("Advertising idle timeout; pausing advertising until a key is pressed");
+        int err = bt_le_adv_stop();
+        if (err) {
+            LOG_ERR("Failed to pause advertising (err %d)", err);
+            return;
+        }
+        advertising_status = ZMK_ADV_NONE;
+        adv_throttled = true;
+    }
+}
+#endif
+
 int update_advertising(void) {
     int err = 0;
     bt_addr_le_t *addr;
@@ -214,7 +271,26 @@ int update_advertising(void) {
     case ZMK_ADV_CONN + CURR_ADV(ZMK_ADV_NONE):
         CHECKED_OPEN_ADV();
         break;
+#if IS_ENABLED(CONFIG_TOTEM_ACTIVE_PROFILE_ONLY) && IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+    case ZMK_ADV_CONN + CURR_ADV(ZMK_ADV_CONN):
+        /* Profile switched while already advertising -> restart so the accept
+         * list is rebuilt for the newly-selected profile (stock ZMK skips this
+         * because its advertising is unfiltered). */
+        CHECKED_ADV_STOP();
+        CHECKED_OPEN_ADV();
+        break;
+#endif
+    }
+
+#if IS_ENABLED(CONFIG_TOTEM_ADV_THROTTLE) && IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+    if (advertising_status == ZMK_ADV_CONN) {
+        /* Advertising with nobody connected -> (re)arm the idle timer. */
+        k_work_reschedule(&adv_throttle_work, K_MINUTES(CONFIG_TOTEM_ADV_THROTTLE_TIMEOUT_MIN));
+    } else {
+        k_work_cancel_delayable(&adv_throttle_work);
+        adv_throttled = false;
     }
+#endif
 
     return 0;
 };
@@ -223,6 +299,22 @@ static void update_advertising_callback(struct k_work *work) { update_advertisin
 
 K_WORK_DEFINE(update_advertising_work, update_advertising_callback);
 
+#if IS_ENABLED(CONFIG_TOTEM_ADV_THROTTLE) && IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+/* A key press on either half (the central sees all positions) resumes advertising
+ * after the idle throttle paused it. The first press or two may be lost. */
+static int adv_throttle_keypress_listener(const zmk_event_t *eh) {
+    if (adv_throttled) {
+        adv_throttled = false;
+        LOG_INF("Key pressed; resuming advertising");
+        update_advertising();
+    }
+    return ZMK_EV_EVENT_BUBBLE;
+}
+
+ZMK_LISTENER(totem_adv_throttle, adv_throttle_keypress_listener);
+ZMK_SUBSCRIPTION(totem_adv_throttle, zmk_position_state_changed);
+#endif
+
 static void clear_profile_bond(uint8_t profile) {
     if (bt_addr_le_cmp(&profiles[profile].peer, BT_ADDR_LE_ANY)) {
         bt_unpair(BT_ID_DEFAULT, &profiles[profile].peer);
@@ -737,6 +829,10 @@ static int zmk_ble_init(void) {
         return err;
     }
 
+#if IS_ENABLED(CONFIG_TOTEM_ADV_THROTTLE) && IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+    k_work_init_delayable(&adv_throttle_work, adv_throttle_work_handler);
+#endif
+
 #if IS_ENABLED(CONFIG_SETTINGS)
     settings_register(&profiles_handler);
     k_work_init_delayable(&ble_save_work, ble_save_profile_work);
