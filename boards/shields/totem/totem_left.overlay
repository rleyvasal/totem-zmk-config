#include "totem.dtsi"

&kscan0 {
    col-gpios
        = <&xiao_d 4 GPIO_ACTIVE_HIGH>
        , <&xiao_d 5 GPIO_ACTIVE_HIGH>
        , <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        ;
};

/*
 * USB CDC console for the left (central) half -- see CONFIG_TOTEM_USB_CONSOLE.
 *
 * On a normal left build this is the printk console. It is omitted when
 * CONFIG_ZMK_STUDIO=y: the studio-rpc-usb-uart snippet already selects
 * USB_CDC_ACM, so an unconditional node here becomes a second (or third)
 * Totem Home serial port and Studio's handshake fails. cmake-args cannot
 * turn TOTEM_USB_CONSOLE off because totem.conf sets it y.
 *
 * zmk-usb-logging still adds its own CDC and wins the chosen console.
 */
#ifndef CONFIG_ZMK_STUDIO
&zephyr_udc0 {
    totem_console_uart: totem_console_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/ {
    chosen {
        zephyr,console = &totem_console_uart;
    };
};
#endif
