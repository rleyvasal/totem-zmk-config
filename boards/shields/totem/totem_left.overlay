#include "totem.dtsi"

&kscan0 {
    col-gpios
        = <&xiao_d 4 GPIO_ACTIVE_HIGH>
        , <&xiao_d 5 GPIO_ACTIVE_HIGH>
        , <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        ;
};

/*
 * USB CDC console for the left (central) half -- see CONFIG_TOTEM_USB_CONSOLE.
 *
 * Declared unconditionally, which is safe: with TOTEM_USB_CONSOLE=n nothing selects
 * USB_CDC_ACM, so no driver is built for this node, no interface is added to the USB
 * descriptor, and the chosen console is never read. Turning the Kconfig on is the
 * only thing that makes it real.
 *
 * This exists so &host_log_dump ([ + X) can print on a NORMAL build. It deliberately
 * does not touch CONFIG_LOG -- the deferred logging subsystem is the part that was
 * disabled in 3046d8f for hanging profile switches, and printk needs only a console.
 *
 * Note: on a zmk-usb-logging build the snippet declares its own CDC node and wins the
 * chosen console, so the board enumerates TWO cu.usbmodem* devices. Only one carries
 * the stream; try both.
 */
&zephyr_udc0 {
    totem_console_uart: totem_console_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/ {
    chosen {
        zephyr,console = &totem_console_uart;
    };
};
