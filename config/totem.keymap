/*
 * Studio snippet defines ZMK_BEHAVIORS_KEEP_ALL, which compiles every unused
 * stock behavior and is how an nRF52840 with a USB console runs out of RAM.
 * Undefining it restores the normal rule: only behaviors the keymap (or an
 * explicit KEEP_*) references are built. Harmless on non-Studio images.
 */
#undef ZMK_BEHAVIORS_KEEP_ALL
/* Useful in the Studio palette even if the compiled keymap never binds them. */
#define ZMK_BEHAVIORS_KEEP_NONE
#define ZMK_BEHAVIORS_KEEP_OUT

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define CODE 1
#define NAV  2
#define MOD  3
#define ADJ  4

/ {
    behaviors {
        /*
         * tapping-term-ms 200 -> 280 (2026-07-30).
         *
         * A hold-tap decides "hold" when the key is still down at the end of the
         * term. Across a split, that decision uses when the RELEASE ARRIVES, not
         * when the key was physically released -- and the release crosses the BLE
         * link. The right half was caught scanning `i` (&hmr RALT I) with press and
         * release only 78 ms apart, comfortably a tap, while ALT latched on anyway:
         * the release reached the central late and the term had already expired.
         *
         * A latched modifier then turns every following key into Alt+key, which
         * produces nothing visible. That is what "the right half stopped typing"
         * has been all along -- the right half is fine (4208 scans -> 4208 position
         * events -> 4208 split sends, every press matched by a release, measured
         * during a reported outage) and the central relays in 0 ms median.
         *
         * It also explains why plugging in USB "fixed" it without a reboot: an
         * endpoint change calls zmk_endpoint_clear_reports(), which releases the
         * stuck modifier. BT_SEL does the same, so Tab+Z is the one-key recovery.
         *
         * 280 ms gives a delayed release ~100 ms more room to still count as a tap.
         *
         * 2026-07-30, second attempt: 280 ms was NOT enough -- ALT still latched
         * (observed unambiguously: macOS dictation is bound to an Alt hold, and it
         * fired mid-typing for about a second). Adding hold-trigger-on-release.
         *
         * That changes the decision from a TIMER to an EVENT. Without it the hold
         * fires as soon as an opposite-hand key is seen while this key is still
         * down -- and across a split, "still down" means "its release has not
         * arrived yet", which is exactly what a delayed release looks like. With
         * it, the hold is only considered once the OTHER key is RELEASED, so a late
         * release is still a release rather than a timeout. Transport delay stops
         * being able to manufacture a hold.
         *
         * Cost: a rolling chord like "sh" that used to fire a mod on the way down
         * now waits for the release, so intentional mods feel slightly later. That
         * is the intended trade -- a missed mod costs one keystroke, a latched mod
         * costs everything typed until it clears.
         */
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            // only fire the mod when chorded with an opposite-hand (right) key
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
        };
        
        /* Same reasoning as hml above -- and this is the one that produced the
         * reported symptom, since `i` is &hmr RALT I. */
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            // only fire the mod when chorded with an opposite-hand (left) key
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            hold-trigger-on-release;
        };
        
        td_bs_pipe: backslash_pipe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Dump multi-profile host event ring to USB serial (printk).
        // Used by combo [ + X and ADJ layer. Requires USB CDC console
        // (totem_left_logging or CONFIG_ZMK_USB_LOGGING) to *see* the dump;
        // capture itself works on production BLE without USB.
        host_log_dump: host_log_dump {
            compatible = "zmk,behavior-totem-host-log-dump";
            #binding-cells = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";
        
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0>; 
        };
        
        combo_dictation {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp LA(SPACE)>;
            slow-release;
            layers = <0>; 
        };
        
        combo_enye {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp RA(N)>;
            layers = <0>;
        };

        // Left-half-ONLY reset. Both keys (20 = outer [ , 21 = Z) are on the LEFT
        // half, so this fires WITHOUT the split link and without the right half.
        // The Enter+[ combo can't do this: Enter is on the right half and needs the
        // split link to arrive. Diagnostic when stuck:
        //   fires (left half reboots) -> CPU alive, BLE-stack hang -> keypress recovery viable
        //   does nothing              -> full MCU freeze -> hardware watchdog needed
        // No `layers` property -> active on every layer, so it works whatever state
        // the keymap is in when it wedges.
        combo_reset_left {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&sys_reset>;
        };

        // Left-half-ONLY host event log dump: [ (20) + X (22).
        // Distinct from [ + Z reset. Capture runs all day on production UF2;
        // dump prints over USB serial when a console is present.
        // No `layers` -> works on any layer after an incident.
        combo_host_log_dump {
            timeout-ms = <50>;
            key-positions = <20 22>;
            bindings = <&host_log_dump>;
        };

#ifdef CONFIG_ZMK_STUDIO
        // Two plain &kp keys. Esc+Tab used the MOD layer-tap thumb, so the
        // combo often missed and Chrome just saw Esc/Tab. Q+B are both &kp.
        combo_studio_unlock {
            timeout-ms = <80>;
            key-positions = <0 4>;
            bindings = <&studio_unlock>;
        };
#endif
    };

    macros {
        mac_lock: mac_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI &kp LCTRL>
                     , <&macro_pause_for_release>
                     , <&macro_tap &kp Q>
                     , <&macro_release &kp LGUI &kp LCTRL>;
        };
        
        win_lock: win_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>
                     , <&macro_tap &kp L>
                     , <&macro_release &kp LGUI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

    base_layer {
        bindings = <
                &kp Q           &kp W           &kp F           &kp P           &kp B               &kp J           &kp L           &kp U           &kp Y           &kp SEMI
                &hml LGUI A     &hml LALT R     &hml LSHFT S    &hml LCTRL T    &kp G               &kp M           &hmr LCTRL N    &hmr RSHFT E    &hmr RALT I     &hmr RGUI O
     &kp LBKT   &kp Z           &kp X           &kp C           &kp D           &kp V               &kp K           &kp H           &kp COMMA       &kp DOT         &kp FSLH        &kp RBKT
                                         &kp ESC         &lt CODE BSPC       &lt MOD TAB     &lt ADJ ENTER   &lt NAV SPACE   &kp LSHFT
        >;
    };
code_layer {
        bindings = <
            &kp GRAVE       &kp AT          &kp HASH        &kp SQT         &kp DQT             &kp FSLH        &kp N7          &kp N8          &kp N9          &kp STAR
            &kp LBKT        &hml LALT RBKT  &hml LSHFT LPAR &hml LCTRL RPAR &kp UNDER           &kp MINUS       &hmr LCTRL N4   &hmr RSHFT N5   &hmr RALT N6    &kp PLUS
            &kp CARET       &kp AMPS        &kp PIPE        &kp EXCL        &kp TILDE           &kp DLLR        &kp EQUAL       &kp N1          &kp N2          &kp N3          &kp DOT         &kp PRCNT
                                                            &trans          &trans              &trans          &kp COMMA       &kp N0          &kp BSLH
        >;
    };
nav_layer {
            bindings = <
                &trans          &msc SCRL_UP    &mmv MOVE_UP    &mkp LCLK       &mkp RCLK           &kp PG_UP       &kp HOME        &kp UP          &kp END         &kp DEL
                &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT &msc SCRL_RIGHT     &kp PG_DN       &kp LEFT        &kp DOWN        &kp RIGHT       &kp INS
                &trans          &trans          &msc SCRL_DOWN  &trans          &mkp MB4            &mkp MB5        &trans          &trans        &kp LC(LS(DOWN))  &kp PSCRN       &kp K_UNDO      &trans
                                                                &trans          &kp LSHFT           &kp LCTRL       &trans          &trans          &trans
            >;
        };
mod_layer {
            bindings = <
                &mac_lock       &win_lock       &trans          &trans          &trans              &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_BRI_UP    &trans
                &kp CAPS        &sk LALT        &sk LSHFT       &sk LCTRL       &trans              &kp BSPC        &kp DEL         &kp SPACE       &kp ENTER       &kp TAB
                // LEFT-HALF-ONLY host selection (21-23). MOD is the left Tab thumb (34),
                // so Tab+Z/X/C reach the central WITHOUT the split link -- the ADJ copies
                // need the right-half Enter thumb, which is useless when the right half is
                // dead, unpaired, or flat. That is the whole point of putting them here.
                //
                // Deliberately NO BT_CLR / BT_CLR_ALL on this row. c6da84f put them at
                // Tab+D and Tab+V, two keys from Tab+Z, and on 2026-07-26 profiles 0 and 2
                // were wiped while pressing recovery keys under stress -- the signature was
                // unmistakable (only bonded profiles cleared, active forced to 0, which is
                // exactly what zmk_ble_clear_all_bonds() does). Destructive, unconfirmed
                // bindings do not belong next to the ones you reach for in a panic.
                // Clearing a bond stays on ADJ; settings_reset covers the nuclear case.
                &trans          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &trans              &trans          &kp C_VOL_DN    &kp C_MUTE      &kp C_VOL_UP    &kp C_BRI_DN    &trans          &trans
                                                                &trans          &trans              &trans          &trans          &trans          &trans
            >;
        };
adj_layer {
            bindings = <
                // BT_CLR_ALL removed 2026-07-28: it wipes every bond with no confirmation,
                // and on 07-26 it cost profiles 0 and 2 mid-debugging. Nothing needs a
                // single keystroke that destroys all pairings -- BT_CLR below clears one
                // profile, and settings_reset.uf2 covers the nuclear case deliberately.
                &trans          &kp F7          &kp F8          &kp F9          &kp F12             &trans          &trans          &trans          &trans          &trans
                // BT_SEL 3 / BT_SEL 4 removed 2026-07-25. Only three hosts are ever
                // used, so those bindings did nothing but arm a trap: selecting an
                // unpaired profile made exclusive host evict the only bonded computer
                // on every connect attempt, with no automatic way back. The firmware
                // guard (TOTEM_EVICT_REQUIRES_BONDED_ACTIVE) now survives that state;
                // this removes the easiest way to reach it.
                &trans          &kp F4          &kp F5          &kp F6          &kp F11             &trans          &trans          &trans          &trans          &trans
                &sys_reset      &host_log_dump  &kp F1          &kp F2          &kp F3              &kp F10         &trans          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_CLR      &bt BT_CLR_ALL
                                                                &trans          &trans              &trans          &trans          &trans          &trans
            >;
        };
    };
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

