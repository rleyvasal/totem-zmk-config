config TOTEM_FAULT_CAPTURE
	bool "Record crashes (reason + faulting PC) across a reset"
	select THREAD_NAME
	default n
	help
	  Override k_sys_fatal_error_handler() to record the K_ERR_* reason, the faulting
	  program counter and the running thread into a __noinit RAM struct, print it, and
	  reboot. The next boot reports it via totem_fault_report_and_clear().
	  This is the other half of the 2026-07-26 freeze investigation: the watchdog
	  recovers the keyboard but cannot say why it stopped. A crash lands here with a
	  PC that addr2line resolves to a source line against the matching zmk.elf; a hang
	  never reaches it, so silence after a watchdog reset is itself the diagnosis.
	  The record is magic+CRC protected because __noinit RAM survives a soft reset but
	  is garbage after a power cut, and a garbage record read as a fault would be
	  worse than no record at all.
	  Module src/totem_fault.c. Keep the zmk.elf for whatever build you flashed, or a
	  captured PC is just a number.

config TOTEM_WATCHDOG
	bool "Hardware watchdog: reset the SoC if the firmware stops running"
	select WATCHDOG
	select TASK_WDT
	select TOTEM_FAULT_CAPTURE
	default n
	help
	  Arm the nRF52840 WDT through Zephyr's task watchdog and feed it from three
	  independent contexts, so a hang reports WHICH one stopped rather than just that
	  the firmware died:
	    sched    - lowest-priority thread (scheduler no longer runs normal threads)
	    sysworkq - self-rescheduling delayed work (system workqueue wedged; the prime
	               suspect, since most ZMK/BLE work runs there)
	    timer    - k_timer expiry in ISR context (survives thread starvation, so
	               "only timer fed" localises the fault to scheduling)
	  The expiring channel is recorded via TOTEM_FAULT_CAPTURE and printed next boot.
	  NOTE the callback runs in ISR context (task_wdt uses a k_timer), so it records
	  to RAM and resets -- it cannot persist to flash.
	  This is the only recovery for the 2026-07-26 failure: the left half sat
	  powered but not executing for five hours -- no USB enumeration, no
	  advertising, no keypress handling -- with a charged battery and a working
	  cable. Every other recovery path in this firmware is software, and software
	  does not run on a stopped core (that includes TOTEM_RECOVERY_REBOOT, which
	  calls sys_reboot). Bonds, profiles and settings live in NVS and survive a
	  watchdog reset; it is equivalent to [ + Z, not a settings reset.
	  NOTE: the nRF WDT cannot be stopped once started, and it keeps counting in
	  SYSTEM ON sleep -- which is exactly what we need, since the hang looks like
	  an idle CPU. Module src/totem_watchdog.c.

config TOTEM_WATCHDOG_TIMEOUT_MS
	int "Watchdog timeout in milliseconds"
	depends on TOTEM_WATCHDOG
	default 10000
	range 2000 60000
	help
	  Time without a feed before the SoC resets. Fed every TIMEOUT/3, so two
	  consecutive missed feeds are tolerated before the dog bites. 10 s is long
	  enough that no normal stall (flash write, BLE storm, settings save) trips it
	  and short enough that a real hang costs you a couple of seconds rather than
	  five hours.

config TOTEM_RESET_REASON_CAPTURE
	bool "Record why the SoC last reset (power-on, watchdog, brownout, ...)"
	select HWINFO
	default y
	help
	  Read hwinfo_get_reset_cause() once at boot, print it via printk, and store a
	  TOTEM_HEVT_BOOT record in the host event ring. Without this a watchdog reset
	  is indistinguishable from someone bumping the reset button, and the 07-26
	  incident showed that "what state was it in before it died" is the question we
	  can never answer after the fact. Cheap: one read plus one ring entry per boot.
	  Independent of TOTEM_WATCHDOG -- useful even with the watchdog off, since it
	  also distinguishes brownouts from clean power-ons.

config TOTEM_BOOT_PROFILE_DUMP
	bool "printk each profile's stored host address at boot"
	depends on ZMK_BLE && ZMK_SPLIT_ROLE_CENTRAL
	default y
	help
	  Print `totem_prof <n> <addr>` for every profile at boot, marking the active one
	  with * and empty slots with EMPTY. This is the single most useful diagnostic we
	  have: 2026-07-25 was an active profile that was never paired, and 2026-07-26 was
	  profile 0 holding 00:00:00:00:00:00 while macOS still had its half of the bond.
	  Both were answered by one line. ZMK already logs this as `Loaded ... address for
	  profile N`, but that is a LOG_DBG and TOTEM_USB_CONSOLE leaves CONFIG_LOG off, so
	  on a production image it does not exist -- answering the question meant reflashing
	  to a debug build and destroying the state being investigated.
	  Printed from delayed work, NOT from SYS_INIT: zmk_ble_init() only registers the
	  settings handler, and settings_load() runs in ZMK's main() after every SYS_INIT
	  level. Dumping at init prints all-zeroes on a keyboard with perfectly good bonds.
	  Central-only: zmk_ble_profile_address() and zmk_ble_active_profile_index() are
	  not linked into a peripheral build, so the right half must not select this.
	  Implemented in src/totem_watchdog.c.

config TOTEM_BOOT_PROFILE_DUMP_DELAY_MS
	int "Delay before printing boot diagnostics (ms)"
	depends on TOTEM_BOOT_PROFILE_DUMP || TOTEM_ENDPOINT_LOG
	default 4000
	range 500 30000
	help
	  Must outlast ZMK's main() reaching settings_load(); a few seconds also lets USB
	  enumerate so the line is not printed into a console nobody has attached yet.

config TOTEM_ENDPOINT_LOG
	bool "printk the HID endpoint whenever it changes"
	depends on ZMK_BLE && ZMK_SPLIT_ROLE_CENTRAL
	default y
	help
	  Print `totem_ep changed selected=... preferred=...` on every endpoint change,
	  plus once at boot. Which transport is carrying keystrokes is otherwise invisible
	  -- typing looks identical over USB and BLE -- and it cannot be tested by
	  elimination, because ZMK falls back: get_selected_transport() silently uses the
	  other transport when the preferred one is not ready. So "forced BLE, turned
	  Bluetooth off, still typing" proves nothing; BLE went not-ready and USB took
	  over. Printing preferred AND selected makes that case explicit via a FALLBACK
	  marker. Needed to verify the &out bindings do anything at all.
	  Module src/totem_endpoint_log.c. Uses TOTEM_BOOT_PROFILE_DUMP_DELAY_MS for its
	  boot report, since the preferred endpoint is restored by settings_load() in
	  main(), after every SYS_INIT level.
	  Central-only: a split peripheral has no HID endpoints, so
	  zmk_endpoint_get_selected()/_preferred() are not linked into that build.

config TOTEM_USB_CONSOLE
	bool "USB CDC console on production builds (printk only, no log subsystem)"
	select USB
	select USB_DEVICE_STACK
	select USB_CDC_ACM
	select SERIAL
	select CONSOLE
	select UART_INTERRUPT_DRIVEN
	select UART_LINE_CTRL
	select UART_CONSOLE
	select USB_UART_CONSOLE
	default n
	help
	  Expose a USB serial console so &host_log_dump ([ + X) can actually print on a
	  normal build. This is NOT the zmk-usb-logging snippet: that enables the full
	  deferred logging subsystem with a log thread and per-message formatting, and
	  is what was disabled in 3046d8f for hanging during profile switches. The dump
	  path uses plain printk and needs only a console, so this gives you readable
	  incident data at a fraction of the cost. Leaves CONFIG_LOG alone.
	  Trade-off: adds a CDC ACM interface to the USB descriptor (the keyboard shows
	  up as a composite device) and costs a little RAM. Set n if USB HID misbehaves.

config TOTEM_EXCLUSIVE_HOST
	bool "Keep only the active profile's computer connected (evict background hosts)"
	depends on ZMK_BLE
	default n
	help
	  Disconnect any non-active host so only the selected computer stays linked.
	  Prevents wake/cross-talk and dual-link battery cost, but every BT_SEL pays
	  a full reconnect (often slow on Windows). Prefer TOTEM_LAZY_INACTIVE_HOST
	  for fast switches with multi-link + lazy params on the inactive host.
	  Module src/exclusive_host.c. Central-only. Do not enable together with
	  TOTEM_LAZY_INACTIVE_HOST (lazy mode wants background hosts to stay up).

config TOTEM_LAZY_INACTIVE_HOST
	bool "Multi-link: keep inactive hosts connected with lazy connection params"
	depends on ZMK_BLE
	depends on !TOTEM_EXCLUSIVE_HOST
	default n
	help
	  Leave non-active bonded hosts connected so profile switch does not force
	  a full BLE reconnect (near-instant BT_SEL after both have linked once).
	  Request long interval / high latency on inactive links to reduce battery
	  use and link activity that can disturb a sleeping PC. Active profile gets
	  normal snappy peripheral preferred params. HID still only to active
	  profile. Module src/lazy_inactive_host.c. Central-only.

config TOTEM_LAZY_HOST_MIN_INT
	int "Lazy inactive host min connection interval (1.25 ms units)"
	depends on TOTEM_LAZY_INACTIVE_HOST
	default 80
	range 24 320
	help
	  80 = 100 ms. Host may negotiate differently.

config TOTEM_LAZY_HOST_MAX_INT
	int "Lazy inactive host max connection interval (1.25 ms units)"
	depends on TOTEM_LAZY_INACTIVE_HOST
	default 160
	range 24 320
	help
	  160 = 200 ms.

config TOTEM_LAZY_HOST_LATENCY
	int "Lazy inactive host slave latency (events)"
	depends on TOTEM_LAZY_INACTIVE_HOST
	default 4
	range 0 30

config TOTEM_LAZY_HOST_TIMEOUT
	int "Lazy inactive host supervision timeout (10 ms units)"
	depends on TOTEM_LAZY_INACTIVE_HOST
	default 500
	range 100 3200
	help
	  500 = 5 s.

config TOTEM_EXCLUSIVE_DISCONNECT_REASON
	hex "HCI reason code used to disconnect a background host"
	depends on TOTEM_EXCLUSIVE_HOST
	default 0x13
	help
	  Passed to bt_conn_disconnect() when evicting a background host. 0x13 =
	  remote user terminated (default). Other reasons Zephyr accepts: 0x15 (remote
	  powered off), 0x1A (unsupported remote feature), 0x05 (authentication
	  failure). Tunable because some hosts (notably macOS) mishandle input after a
	  plain user-terminated disconnect; a different reason may make the host
	  reconnect cleanly.

config TOTEM_EVICT_REQUIRES_BONDED_ACTIVE
	bool "Never evict a bonded host while the active profile is unbonded"
	depends on TOTEM_EXCLUSIVE_HOST
	default y
	help
	  Suppress background-host eviction whenever the active profile has no bond
	  (zmk_ble_active_profile_is_open()). Without this, selecting an empty
	  profile makes the keyboard reject the only computer that wants it, forever:
	  the host connects, eviction fires on idx != active, the host retries, and
	  the loop runs at several hertz until a BT_SEL rescues it. Observed
	  2026-07-25 with active=4 and macOS bonded at idx=0 -- 16 evictions per 10 s
	  window, macOS permanently greyed out, and the split slot table corrupted as
	  collateral. Exclusivity only has a meaning to enforce when the selected
	  profile actually has a host, so this costs nothing when one is paired.
	  Implemented in src/exclusive_host.c. Central-only.

config TOTEM_BOND_HEAL
	bool "Auto-clear active profile bond after repeated auth failures"
	depends on TOTEM_EXCLUSIVE_HOST
	default n
	help
	  When the active host fails encryption/auth repeatedly (HCI 0x05 or
	  security_changed errors), clear that profile's bond on the keyboard.
	  Default n: dual-host thrash can produce transient security errors that
	  must not wipe a good bond. Experimental only with a logging build.
	  Implemented in src/exclusive_host.c. Central-only.

config TOTEM_BOND_HEAL_THRESHOLD
	int "Consecutive active-profile auth failures before bond clear"
	depends on TOTEM_BOND_HEAL
	default 3
	range 2 10

config TOTEM_RESELECT_RECONNECT
	bool "Re-selecting the active profile forces a soft reconnect"
	depends on TOTEM_ADV_THROTTLE
	default y
	help
	  Pressing BT_SEL for the profile that is already active disconnects that
	  host (if connected) and re-advertises with the boost window. Soft recovery
	  for half-dead links (especially macOS Connected-but-mute) without a full
	  Forget + re-pair. Implemented in patches/zmk-ble.patch. Central-only.

config TOTEM_EVICT_ADV_COOLDOWN_MS
	int "Delay re-advertising after a non-active host disconnects (ms)"
	depends on TOTEM_ADV_THROTTLE
	default 0
	range 0 5000
	help
	  When a background (non-active) host disconnects and the active profile is
	  still not connected, wait this many milliseconds before restarting open
	  advertising. DEFAULT 0 (off): a non-zero value also blinds the *selected*
	  host during the pause, which made dual-host switch worse (Win thrash
	  starved Mac). Keep 0 unless experimenting with a logging build. Profile
	  switch and active-host disconnect always re-advertise immediately.
	  Implemented in patches/zmk-ble.patch. Central-only.

config TOTEM_ACTIVE_ADV_FILTER
	bool "Advertise with filter accept list: only active profile may connect"
	depends on TOTEM_ADV_THROTTLE
	depends on BT_FILTER_ACCEPT_LIST
	default n
	help
	  When the active profile is bonded, advertising uses
	  BT_LE_ADV_OPT_FILTER_CONN and the filter accept list contains only that
	  profile's peer. Background bonded hosts cannot complete a connection
	  (stops multi-host thrash that can rot the selected bond). Open/empty
	  profiles advertise unfiltered for pairing. Fail-open: any FAL setup or
	  filtered start failure falls back to unfiltered open advertising.
	  Earlier 2026-07 attempt: no ads on some builds — re-enabled 2026-07-21
	  with clearer fallback; set n in totem.conf if ads vanish. Central-only.

config TOTEM_RECONNECT_WATCH
	bool "Watchdog for stuck profile-switch reconnects"
	depends on ZMK_BLE
	default y
	help
	  After BT_SEL, if the active bonded host does not come up, run a recovery
	  ladder: kick advertising, force-evict background hosts, then soft-drop a
	  zombie host conn. Never clears bonds. Module src/reconnect_watch.c.
	  Central-only.

config TOTEM_RECONNECT_WATCH_SEC
	int "Seconds between reconnect watch recovery steps"
	depends on TOTEM_RECONNECT_WATCH
	default 8
	range 4 30

config TOTEM_RECONNECT_WATCH_ON_ACTIVE_DOWN
	bool "Arm light reconnect ladder when the active host disconnects mid-session"
	depends on TOTEM_RECONNECT_WATCH
	default y
	help
	  When a peer that maps to the active profile disconnects (not background
	  thrash, not unresolved RPA), arm the light recovery ladder: densify ads /
	  kick open advertising, force-evict background hosts, soft-drop zombie.
	  Never full reselect (avoids Class D mute risk). Skips when advertising is
	  intentionally suppressed (idle go-dark / throttle). Central-only.

config TOTEM_THRASH_DETECT
	bool "Count background host evictions for multi-host thrash logging"
