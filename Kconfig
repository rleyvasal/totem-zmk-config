config TOTEM_ACTIVE_PROFILE_ONLY
	bool "Keep only the active profile's computer connected (one host at a time)"
	depends on ZMK_BLE
	default n
	help
	  On the central half: when you switch profiles, disconnect any OTHER profile's
	  computer that is still connected in the background, and drop non-active hosts
	  on connect. Fixes cross-talk (keystrokes leaking to the wrong computer) since
	  ZMK otherwise keeps both connected. RPA-safe: only disconnects a host that
	  matches a KNOWN, different profile; an unrecognized address is left alone, so
	  it never wedges your legit active host. Module in
	  src/active_profile_only.c (no ZMK patch needed). Central-only.

config TOTEM_EXCLUSIVE_HOST
	bool "Keep only the active profile's computer connected (evict background hosts)"
	depends on ZMK_BLE
	default n
	help
	  On the central half: disconnect any non-active profile's computer that is
	  still connected in the background, and drop a non-active host the moment it
	  connects, so only the selected computer stays connected. Generic -- no
	  per-host configuration; the active profile is kept, everything else is
	  evicted. A connection whose address does not yet resolve to a stored profile
	  is left alone (protects an active host mid-reconnect). Module in
	  src/exclusive_host.c (no ZMK patch needed). Central-only.

config TOTEM_EXCLUSIVE_DISCONNECT_REASON
	hex "HCI reason code used to disconnect a background host"
	depends on TOTEM_EXCLUSIVE_HOST
	default 0x13
	help
	  Passed to bt_conn_disconnect() when evicting a background host. 0x13 =
	  remote user terminated (default). Other reasons Zephyr accepts: 0x15 (remote
	  powered off), 0x1A (unsupported remote feature), 0x05 (authentication
	  failure). Tunable because some hosts (notably macOS) mishandle input after a
	  plain user-terminated disconnect; a different reason may make the host
	  reconnect cleanly.

config TOTEM_ADV_THROTTLE
	bool "Pause advertising after the selected host has been away for a while"
	depends on ZMK_BLE
	default n
	help
	  When the selected profile's device has been disconnected for
	  TOTEM_ADV_THROTTLE_TIMEOUT_MIN minutes, stop advertising to save power. A key
	  press on either half resumes it (the first press or two may be lost). This also
	  stops cross-talk -- nothing can connect while not advertising -- so it does not
	  need address-based filtering. Implemented by patches/totem-ble.patch on our ZMK
	  fork. Central-only.

config TOTEM_ADV_THROTTLE_TIMEOUT_MIN
	int "Minutes the selected host may be away before advertising is paused"
	depends on TOTEM_ADV_THROTTLE
	default 5

config TOTEM_IDLE_DISCONNECT
	bool "Disconnect the active host after a long keypress-idle window"
	depends on ZMK_BLE
	default n
	help
	  On the central half: after CONFIG_TOTEM_IDLE_DISCONNECT_MIN minutes with no
	  keypress, disconnect the active host. macOS keeps its BLE link alive during
	  sleep, so the keyboard otherwise stays connected-idle overnight and the
	  advertising throttle never engages. Dropping the idle host lets the throttle
	  pause advertising -> lower idle drain. A present (awake) host just reconnects
	  cleanly (the same path the exclusive-host module relies on); the only cost is
	  the first keystroke after a long idle. Pairs with CONFIG_TOTEM_ADV_THROTTLE.
	  Module in src/idle_disconnect.c (no ZMK patch needed). Central-only.

config TOTEM_IDLE_DISCONNECT_MIN
	int "Minutes without a keypress before the active host is disconnected"
	depends on TOTEM_IDLE_DISCONNECT
	default 20

config TOTEM_DISCONNECT_ON_PROFILE_SWITCH
	bool "Disconnect the current computer when you switch BLE profiles"
	depends on ZMK_BLE
	default n
	help
	  On an explicit profile switch (&bt BT_SEL), disconnect whatever host is
	  currently connected so the newly-selected computer can connect fresh -- one
	  host at a time, no cross-talk. Disconnects by connection/role, NOT by address,
	  so it never mishandles a macOS RPA (the bug that broke TOTEM_ACTIVE_PROFILE_ONLY).
	  Normal reconnects after absence are untouched. Via patches/totem-ble.patch on
	  the ZMK fork. Central-only.
