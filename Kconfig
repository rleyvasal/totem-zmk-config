config TOTEM_ACTIVE_PROFILE_ONLY
	bool "Keep only the active profile's computer connected (one host at a time)"
	depends on ZMK_BLE
	default n
	help
	  On the central half: when you switch profiles, disconnect any OTHER profile's
	  computer that is still connected in the background, and drop non-active hosts
	  on connect. Fixes cross-talk (keystrokes leaking to the wrong computer) since
	  ZMK otherwise keeps both connected. RPA-safe: only disconnects a host that
	  matches a KNOWN, different profile; an unrecognized address is left alone, so
	  it never wedges your legit active host. Module in
	  src/active_profile_only.c (no ZMK patch needed). Central-only.

config TOTEM_ADV_THROTTLE
	bool "Pause advertising after the selected host has been away for a while"
	depends on ZMK_BLE
	default n
	help
	  When the selected profile's device has been disconnected for
	  TOTEM_ADV_THROTTLE_TIMEOUT_MIN minutes, stop advertising to save power. A key
	  press on either half resumes it (the first press or two may be lost). This also
	  stops cross-talk -- nothing can connect while not advertising -- so it does not
	  need address-based filtering. Implemented by patches/totem-ble.patch on our ZMK
	  fork. Central-only.

config TOTEM_ADV_THROTTLE_TIMEOUT_MIN
	int "Minutes the selected host may be away before advertising is paused"
	depends on TOTEM_ADV_THROTTLE
	default 5

config TOTEM_DISCONNECT_ON_PROFILE_SWITCH
	bool "Disconnect the current computer when you switch BLE profiles"
	depends on ZMK_BLE
	default n
	help
	  On an explicit profile switch (&bt BT_SEL), disconnect whatever host is
	  currently connected so the newly-selected computer can connect fresh -- one
	  host at a time, no cross-talk. Disconnects by connection/role, NOT by address,
	  so it never mishandles a macOS RPA (the bug that broke TOTEM_ACTIVE_PROFILE_ONLY).
	  Normal reconnects after absence are untouched. Via patches/totem-ble.patch on
	  the ZMK fork. Central-only.
