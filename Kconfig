config TOTEM_EXCLUSIVE_HOST
	bool "Keep only the active profile's computer connected (evict background hosts)"
	depends on ZMK_BLE
	default n
	help
	  On the central half: disconnect any non-active profile's computer that is
	  still connected in the background, and drop a non-active host shortly after
	  it connects, so only the selected computer stays connected. Generic -- no
	  per-host configuration; the active profile is kept, everything else is
	  evicted. A connection whose address does not yet resolve to a stored profile
	  is left alone (protects an active host mid-reconnect), and a freshly
	  connected host is only evicted once its encryption handshake has settled
	  (interrupted handshakes can leave keyboard and host with mismatched bonds).
	  Module in src/exclusive_host.c (no ZMK patch needed). Central-only.

config TOTEM_EXCLUSIVE_DISCONNECT_REASON
	hex "HCI reason code used to disconnect a background host"
	depends on TOTEM_EXCLUSIVE_HOST
	default 0x13
	help
	  Passed to bt_conn_disconnect() when evicting a background host. 0x13 =
	  remote user terminated (default). Other reasons Zephyr accepts: 0x15 (remote
	  powered off), 0x1A (unsupported remote feature), 0x05 (authentication
	  failure). Tunable because some hosts (notably macOS) mishandle input after a
	  plain user-terminated disconnect; a different reason may make the host
	  reconnect cleanly.

config TOTEM_BOND_HEAL
	bool "Auto-clear active profile bond after repeated auth failures"
	depends on TOTEM_EXCLUSIVE_HOST
	default n
	help
	  When the active host fails encryption/auth repeatedly (HCI 0x05 or
	  security_changed errors), clear that profile's bond on the keyboard.
	  Default n: dual-host thrash can produce transient security errors that
	  must not wipe a good bond. Experimental only with a logging build.
	  Implemented in src/exclusive_host.c. Central-only.

config TOTEM_BOND_HEAL_THRESHOLD
	int "Consecutive active-profile auth failures before bond clear"
	depends on TOTEM_BOND_HEAL
	default 3
	range 2 10

config TOTEM_RESELECT_RECONNECT
	bool "Re-selecting the active profile forces a soft reconnect"
	depends on TOTEM_ADV_THROTTLE
	default y
	help
	  Pressing BT_SEL for the profile that is already active disconnects that
	  host (if connected) and re-advertises with the boost window. Soft recovery
	  for half-dead links (especially macOS Connected-but-mute) without a full
	  Forget + re-pair. Implemented in patches/zmk-ble.patch. Central-only.

config TOTEM_EVICT_ADV_COOLDOWN_MS
	int "Delay re-advertising after a non-active host disconnects (ms)"
	depends on TOTEM_ADV_THROTTLE
	default 0
	range 0 5000
	help
	  When a background (non-active) host disconnects and the active profile is
	  still not connected, wait this many milliseconds before restarting open
	  advertising. DEFAULT 0 (off): a non-zero value also blinds the *selected*
	  host during the pause, which made dual-host switch worse (Win thrash
	  starved Mac). Keep 0 unless experimenting with a logging build. Profile
	  switch and active-host disconnect always re-advertise immediately.
	  Implemented in patches/zmk-ble.patch. Central-only.

config TOTEM_ACTIVE_ADV_FILTER
	bool "Advertise with filter accept list: only active profile may connect"
	depends on TOTEM_ADV_THROTTLE
	depends on BT_FILTER_ACCEPT_LIST
	default n
	help
	  When the active profile is bonded, advertising uses
	  BT_LE_ADV_OPT_FILTER_CONN and the filter accept list contains only that
	  profile's peer. Background bonded hosts cannot complete a connection
	  (stops multi-host thrash that can rot the selected bond). Open/empty
	  profiles advertise unfiltered for pairing. Fail-open: any FAL setup or
	  filtered start failure falls back to unfiltered open advertising.
	  Earlier 2026-07 attempt: no ads on some builds — re-enabled 2026-07-21
	  with clearer fallback; set n in totem.conf if ads vanish. Central-only.

config TOTEM_RECONNECT_WATCH
	bool "Watchdog for stuck profile-switch reconnects"
	depends on ZMK_BLE
	default y
	help
	  After BT_SEL, if the active bonded host does not come up, run a recovery
	  ladder: kick advertising, force-evict background hosts, then soft-drop a
	  zombie host conn. Never clears bonds. Module src/reconnect_watch.c.
	  Central-only.

config TOTEM_RECONNECT_WATCH_SEC
	int "Seconds between reconnect watch recovery steps"
	depends on TOTEM_RECONNECT_WATCH
	default 8
	range 4 30

config TOTEM_RECONNECT_WATCH_ON_ACTIVE_DOWN
	bool "Arm light reconnect ladder when the active host disconnects mid-session"
	depends on TOTEM_RECONNECT_WATCH
	default y
	help
	  When a peer that maps to the active profile disconnects (not background
	  thrash, not unresolved RPA), arm the light recovery ladder: densify ads /
	  kick open advertising, force-evict background hosts, soft-drop zombie.
	  Never full reselect (avoids Class D mute risk). Skips when advertising is
	  intentionally suppressed (idle go-dark / throttle). Central-only.

config TOTEM_THRASH_DETECT
	bool "Count background host evictions for multi-host thrash logging"
	depends on TOTEM_EXCLUSIVE_HOST
	default y
	help
	  Maintain a sliding-window counter of successful exclusive-host background
	  evictions (any non-active profile) and emit totem_ble thrash_win /
	  CLASS_A_SUSPECT logs. Does not change advertising or eviction behavior by
	  itself. Central-only.

config TOTEM_THRASH_WINDOW_SEC
	int "Seconds in the thrash sliding window"
	depends on TOTEM_THRASH_DETECT
	default 10
	range 3 60

config TOTEM_HOST_EVENT_LOG
	bool "Multi-profile host event ring (RAM + settings) with USB dump"
	depends on ZMK_BLE
	default y
	help
	  Record connect/disconnect/security/thrash/watch events for any BLE
	  profile index into a circular ring. Persist snapshots to settings so
	  history survives reboot and firmware flash (without settings-reset).
	  Dump with &host_log_dump (combo) via printk over USB CDC when console
	  logging is enabled (zmk-usb-logging snippet or CONFIG_ZMK_USB_LOGGING).
	  Capture works on the normal production image without USB attached.
	  Implemented in src/host_event_log.c. Central sources; dump on left.

config TOTEM_HOST_EVENT_LOG_SIZE
	int "Host event ring capacity"
	depends on TOTEM_HOST_EVENT_LOG
	default 128
	range 32 256

config TOTEM_HOST_EVENT_LOG_PERSIST_EVERY
	int "Persist ring to settings after this many new events"
	depends on TOTEM_HOST_EVENT_LOG
	default 16
	range 1 128
	help
	  Limits flash wear. Dump always persists. Profile changes also trigger
	  a persist from exclusive-host / reconnect-watch call sites when wired.

config TOTEM_ADV_THROTTLE
	bool "Pause advertising after the selected host has been away for a while"
	depends on ZMK_BLE
	default n
	help
	  When the selected profile's device has been disconnected for
	  TOTEM_ADV_THROTTLE_TIMEOUT_MIN minutes, stop advertising to save power. A key
	  press on either half resumes it (the first press or two may be lost). This also
	  stops cross-talk -- nothing can connect while not advertising -- so it does not
	  need address-based filtering. Implemented by patches/zmk-ble.patch on our ZMK
	  fork. Central-only.

config TOTEM_ADV_THROTTLE_TIMEOUT_MIN
	int "Minutes the selected host may be away before advertising is paused"
	depends on TOTEM_ADV_THROTTLE
	default 5

config TOTEM_ADV_BOOST
	bool "Faster advertising after profile switch (and wake from dark)"
	depends on TOTEM_ADV_THROTTLE
	default y
	help
	  For TOTEM_ADV_BOOST_SEC after a profile switch (or keypress resume from
	  advertising-dark), advertise at Bluetooth GAP "fast interval 1" (30-60 ms)
	  instead of ZMK's default "fast interval 2" (100-150 ms). Denser advertising
	  helps the newly selected host discover the keyboard sooner. Implemented in
	  patches/zmk-ble.patch. Central-only. Small extra radio use only during the
	  short boost window.

config TOTEM_ADV_BOOST_SEC
	int "Seconds of dense advertising after profile switch"
	depends on TOTEM_ADV_BOOST
	default 12
	range 3 60

config TOTEM_ADV_POST_SWITCH_DARK
	bool "After profile-switch boost, go dark if selected host not connected"
	depends on TOTEM_ADV_BOOST
	default y
	help
	  When the boost window after BT_SEL ends and the selected host is still
	  not connected, pause advertising until a keypress. Limits open-ad thrash
	  from background bonded hosts (which can rot the selected bond) without
	  Filter Accept List. Cost: if the host is slow, press any key to resume
	  advertising. Implemented in patches/zmk-ble.patch. Central-only.

config TOTEM_IDLE_DISCONNECT
	bool "Disconnect the active host after a long keypress-idle window (then go dark)"
	depends on TOTEM_ADV_THROTTLE
	default n
	help
	  On the central half: after CONFIG_TOTEM_IDLE_DISCONNECT_MIN minutes with no
	  keypress, disconnect the active host AND immediately pause advertising ("go
	  dark"), so it cannot instantly reconnect and wake the host. A key press resumes
	  advertising (via the throttle listener) and the host reconnects; an asleep/away
	  host simply stays gone, so idle drain falls to the throttled rate with no wake
	  storm. macOS keeps its BLE link alive during sleep, so without this the keyboard
	  stays connected-idle overnight. Requires TOTEM_ADV_THROTTLE (shares its
	  advertising-pause machinery). Implemented in patches/zmk-ble.patch on the ZMK
	  fork, not a standalone module. Central-only.

config TOTEM_IDLE_DISCONNECT_MIN
	int "Minutes without a keypress before the active host is disconnected"
	depends on TOTEM_IDLE_DISCONNECT
	default 20
